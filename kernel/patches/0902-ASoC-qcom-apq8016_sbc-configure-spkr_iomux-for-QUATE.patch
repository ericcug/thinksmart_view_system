From 665d1b735a7e505c3c115ec8c17f90627dbda126 Mon Sep 17 00:00:00 2001
From: Eric <eric@localhost>
Date: Sun, 8 Nov 2026 00:08:12 +0800
Subject: [PATCH 2/7] ASoC: qcom: apq8016_sbc: configure spkr_iomux for
 QUATERNARY_MI2S

---
 sound/soc/qcom/apq8016_sbc.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/sound/soc/qcom/apq8016_sbc.c b/sound/soc/qcom/apq8016_sbc.c
index 1c6c27a2f..c41cd01ec 100644
--- a/sound/soc/qcom/apq8016_sbc.c
+++ b/sound/soc/qcom/apq8016_sbc.c
@@ -78,6 +78,16 @@ static int apq8016_dai_init(struct snd_soc_pcm_runtime *rtd, int mi2s)
 		writel(readl(pdata->mic_iomux) | MIC_CTRL_QUA_WS_SLAVE_SEL_10 |
 			MIC_CTRL_TLMM_SCLK_EN,
 			pdata->mic_iomux);
+		/*
+		 * On Lenovo CD-18781Y, QUAT MI2S output is routed through the
+		 * SEC MI2S physical pins (GPIO 135-138): enable the TLMM
+		 * drivers in spkr_iomux, as the SECONDARY case does.
+		 */
+		value = readl(pdata->spkr_iomux) &
+			~(SPKR_CTL_TLMM_WS_OUT_SEL_MASK | SPKR_CTL_TLMM_WS_EN_SEL_MASK);
+		writel(value | SPKR_CTL_TLMM_MCLK_EN | SPKR_CTL_TLMM_SCLK_EN |
+			SPKR_CTL_TLMM_DATA1_EN | SPKR_CTL_TLMM_WS_OUT_SEL_SEC |
+			SPKR_CTL_TLMM_WS_EN_SEL_SEC, pdata->spkr_iomux);
 		break;
 	case MI2S_SECONDARY:
 		/* Clear TLMM_WS_OUT_SEL and TLMM_WS_EN_SEL fields */
-- 
