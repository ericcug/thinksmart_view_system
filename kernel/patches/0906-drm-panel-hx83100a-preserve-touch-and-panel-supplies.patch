From b2b2b98e1fb86024e50d45a9020048b3fc3c4836 Mon Sep 17 00:00:00 2001
From: Eric <eric@localhost>
Date: Sun, 8 Nov 2026 00:08:12 +0800
Subject: [PATCH 6/7] drm/panel: hx83100a: preserve touch and panel supplies
 during blanking

---
 .../panel-lenovo-cd-18781y-hx83100a.c         | 62 +++++++++++++++----
 1 file changed, 50 insertions(+), 12 deletions(-)

diff --git a/drivers/gpu/drm/panel/msm8953-generated/panel-lenovo-cd-18781y-hx83100a.c b/drivers/gpu/drm/panel/msm8953-generated/panel-lenovo-cd-18781y-hx83100a.c
index a0c789690..fa4d591f0 100644
--- a/drivers/gpu/drm/panel/msm8953-generated/panel-lenovo-cd-18781y-hx83100a.c
+++ b/drivers/gpu/drm/panel/msm8953-generated/panel-lenovo-cd-18781y-hx83100a.c
@@ -21,6 +21,8 @@ struct hx83100a_800p {
 	struct mipi_dsi_device *dsi;
 	struct regulator_bulk_data *supplies;
 	struct gpio_desc *reset_gpio;
+	bool supplies_enabled;
+	bool reset_released;
 };
 
 static const struct regulator_bulk_data hx83100a_800p_supplies[] = {
@@ -41,6 +43,27 @@ static void hx83100a_800p_reset(struct hx83100a_800p *ctx)
 	usleep_range(5000, 6000);
 	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
 	msleep(50);
+	ctx->reset_released = true;
+}
+
+static int hx83100a_800p_power_off(struct hx83100a_800p *ctx)
+{
+	int ret;
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	ctx->reset_released = false;
+
+	if (!ctx->supplies_enabled)
+		return 0;
+
+	ret = regulator_bulk_disable(ARRAY_SIZE(hx83100a_800p_supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(&ctx->dsi->dev, "Failed to disable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ctx->supplies_enabled = false;
+	return 0;
 }
 
 static int hx83100a_800p_on(struct hx83100a_800p *ctx)
@@ -84,21 +107,25 @@ static int hx83100a_800p_prepare(struct drm_panel *panel)
 {
 	struct hx83100a_800p *ctx = to_hx83100a_800p(panel);
 	struct device *dev = &ctx->dsi->dev;
+	bool retained = ctx->supplies_enabled && ctx->reset_released;
 	int ret;
 
-	ret = regulator_bulk_enable(ARRAY_SIZE(hx83100a_800p_supplies), ctx->supplies);
-	if (ret < 0) {
-		dev_err(dev, "Failed to enable regulators: %d\n", ret);
-		return ret;
+	if (!ctx->supplies_enabled) {
+		ret = regulator_bulk_enable(ARRAY_SIZE(hx83100a_800p_supplies), ctx->supplies);
+		if (ret < 0) {
+			dev_err(dev, "Failed to enable regulators: %d\n", ret);
+			return ret;
+		}
+		ctx->supplies_enabled = true;
 	}
 
-	hx83100a_800p_reset(ctx);
+	if (!retained)
+		hx83100a_800p_reset(ctx);
 
 	ret = hx83100a_800p_on(ctx);
 	if (ret < 0) {
 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
-		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-		regulator_bulk_disable(ARRAY_SIZE(hx83100a_800p_supplies), ctx->supplies);
+		hx83100a_800p_power_off(ctx);
 		return ret;
 	}
 
@@ -112,13 +139,12 @@ static int hx83100a_800p_unprepare(struct drm_panel *panel)
 	int ret;
 
 	ret = hx83100a_800p_off(ctx);
-	if (ret < 0)
+	if (ret < 0) {
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+		hx83100a_800p_power_off(ctx);
+	}
 
-	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-	regulator_bulk_disable(ARRAY_SIZE(hx83100a_800p_supplies), ctx->supplies);
-
-	return 0;
+	return ret;
 }
 
 static const struct drm_display_mode hx83100a_800p_mode = {
@@ -198,11 +224,22 @@ static int hx83100a_800p_probe(struct mipi_dsi_device *dsi)
 	return 0;
 }
 
+static void hx83100a_800p_shutdown(struct mipi_dsi_device *dsi)
+{
+	struct hx83100a_800p *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_disable(&ctx->panel);
+	drm_panel_unprepare(&ctx->panel);
+	hx83100a_800p_power_off(ctx);
+}
+
 static void hx83100a_800p_remove(struct mipi_dsi_device *dsi)
 {
 	struct hx83100a_800p *ctx = mipi_dsi_get_drvdata(dsi);
 	int ret;
 
+	hx83100a_800p_shutdown(dsi);
+
 	ret = mipi_dsi_detach(dsi);
 	if (ret < 0)
 		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
@@ -219,6 +256,7 @@ MODULE_DEVICE_TABLE(of, hx83100a_800p_of_match);
 static struct mipi_dsi_driver hx83100a_800p_driver = {
 	.probe = hx83100a_800p_probe,
 	.remove = hx83100a_800p_remove,
+	.shutdown = hx83100a_800p_shutdown,
 	.driver = {
 		.name = "panel-hx83100a-800p",
 		.of_match_table = hx83100a_800p_of_match,
-- 
2.47.3

