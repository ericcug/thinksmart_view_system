[Unit]
Description=TSV Kiosk: Weston kiosk-shell with fullscreen WebKit2GTK for tsv-voice on tty1
After=systemd-user-sessions.service getty@tty1.service tsv-voice.service
Wants=tsv-voice.service
Conflicts=getty@tty1.service

[Service]
User=ubuntu
PAMName=tsv-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SESSION_DESKTOP=TSVKiosk XDG_CURRENT_DESKTOP=TSVKiosk
ExecStart=/usr/local/bin/tsv-kiosk-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
